# Local UI inspection with authentication and execution unavailable.
# For the hosted personal app, configure the server-only values below in Vercel.
QUELLIGHT_MODE=foundation
QUELLIGHT_DEPLOYMENT=local
HOST=127.0.0.1
PORT=4317
# Hosted entry requires its exact public HTTPS origin; see deployment preflight.
# ORIGIN=https://your-quellight-host.example
# On Render only, RENDER_EXTERNAL_URL supplies a validated fallback when ORIGIN is absent.
# On Vercel, omit the local settings above: VERCEL=1 selects hosted mode and
# the platform's VERCEL_URL supplies the origin when ORIGIN is absent.
# Never copy this local example wholesale into Vercel project environment variables.

# Personal mode requires all of these server-side values. Keep real values out
# of this file and Git; the provider key belongs in Vercel Secret storage.
# QUELLIGHT_MODE=personal
# QUELLIGHT_DATABASE_URL=postgresql://runtime-user:password@pooler-host:6543/postgres
# QUELLIGHT_DATABASE_CA=<trusted PEM CA certificate>
# SUPABASE_URL=https://project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<project publishable key>
# QUELLIGHT_OWNER_SUBJECT=<verified owner account UUID>
# QUELLIGHT_OWNER_EMAIL=<owner email>
# ZHIPU_API_KEY=<active Z.AI Coding Plan key>
