{
  "name": "quellight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quellight — a private companion built with VICT",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 127.0.0.1 --port 4317 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/check-http.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "preview:ui": "node scripts/preview-ui.mjs",
    "build:node": "node scripts/build.mjs node",
    "build:vercel": "node scripts/build.mjs vercel",
    "test:vercel": "node scripts/check-vercel.mjs"
  },
  "dependencies": {
    "@mastra/core": "1.64.0",
    "@mastra/libsql": "1.22.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/functions": "3.11.3",
    "@victframework/application": "file:packs/victframework-application-0.4.0-rc.1.tgz",
    "@victframework/contracts": "file:packs/victframework-contracts-0.4.0-rc.1.tgz",
    "@victframework/control": "file:packs/victframework-control-0.4.0-rc.1.tgz",
    "@victframework/hosted": "file:packs/victframework-hosted-0.4.0-rc.1.tgz",
    "@victframework/kernel": "file:packs/victframework-kernel-0.4.0-rc.1.tgz",
    "@victframework/mastra": "file:packs/mastra-0.4.0-rc.1-vhost025-7f4b0b8f2cf5.tgz",
    "@victframework/runtime": "file:packs/runtime-0.4.0-rc.1-memory-e94ee682d7f5.tgz",
    "@victframework/sdk": "file:packs/victframework-sdk-0.4.0-rc.1.tgz",
    "@victframework/store-postgres": "file:packs/store-postgres-vhost013.tgz",
    "@victframework/ui": "file:packs/victframework-ui-0.4.0-rc.1.tgz",
    "@victframework/ui-ai-svelte": "file:packs/victframework-ui-ai-svelte-0.4.0-rc.1.tgz",
    "@victframework/ui-media-svelte": "file:packs/victframework-ui-media-svelte-0.4.0-rc.1.tgz",
    "@victframework/ui-patterns-svelte": "file:packs/victframework-ui-patterns-svelte-0.4.0-rc.1.tgz",
    "@victframework/ui-svelte": "file:packs/victframework-ui-svelte-0.4.0-rc.1.tgz"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/adapter-vercel": "6.3.5",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "22.13.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "packageManager": "npm@11.21.2"
}
