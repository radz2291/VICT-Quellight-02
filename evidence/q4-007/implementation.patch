@@ -0,0 +1,128 @@
+import { parseObservationGroups } from '@mastra/memory/processors';
+import type { MastraDBMessage } from '@mastra/core/memory';
+
+export type MemoryObservationGroupMembership =
+  | { readonly groupId: string; readonly status: 'unavailable' }
+  | {
+      readonly groupId: string;
+      readonly status: 'available';
+      readonly basis: 'observe-input' | 'retained-parents';
+      readonly messageIds: readonly string[];
+    };
+
+export interface MemoryObservationSourceMembership {
+  readonly schema: 'vict.mastra-observation-membership@1';
+  readonly groups: readonly MemoryObservationGroupMembership[];
+}
+
+type Available = Extract<MemoryObservationGroupMembership, { status: 'available' }>;
+type ObservationProof = { groupId: string; messageIds: readonly string[] };
+type ReflectionProof = readonly { groupId: string; parentIds: readonly string[] }[];
+export const nativePublicationProof = Symbol.for('vict.mastra.observation-publication-proof@1');
+
+function uniqueGroups(observations: string) {
+  const groups = new Map<string, ReturnType<typeof parseObservationGroups>[number] | undefined>();
+  for (const group of parseObservationGroups(observations))
+    groups.set(group.id, groups.has(group.id) ? undefined : group);
+  return groups;
+}
+
+export function publicationMembership(
+  observations: string,
+  proof?: unknown,
+): MemoryObservationSourceMembership {
+  const dto = proof as MemoryObservationSourceMembership | undefined;
+  const members = new Map<string, MemoryObservationGroupMembership | undefined>();
+  if (dto?.schema === 'vict.mastra-observation-membership@1' && Array.isArray(dto.groups)) {
+    for (const entry of dto.groups) {
+      if (typeof entry?.groupId !== 'string') continue;
+      const available = entry.status === 'available' &&
+        (entry.basis === 'observe-input' || entry.basis === 'retained-parents') &&
+        Array.isArray(entry.messageIds) && entry.messageIds.length > 0 &&
+        entry.messageIds.every((id: unknown) => typeof id === 'string' && id.length > 0) &&
+        new Set(entry.messageIds).size === entry.messageIds.length;
+      members.set(entry.groupId, !members.has(entry.groupId) && available
+        ? { groupId: entry.groupId, status: 'available', basis: entry.basis, messageIds: entry.messageIds }
+        : undefined);
+    }
+  }
+  return {
+    schema: 'vict.mastra-observation-membership@1',
+    groups: [...uniqueGroups(observations)].map(([groupId, group]) =>
+      (group && members.get(groupId)) || { groupId, status: 'unavailable' },
+    ),
+  };
+}
+
+/** Staged facts are private until the authority-fenced operation commits. */
+export class NativeStageMembership {
+  #sourceOrder: Map<string, number>;
+  #observations: string;
+  #published: MemoryObservationSourceMembership;
+
+  constructor(
+    messages: readonly MastraDBMessage[],
+    observations: string,
+    prior?: unknown,
+  ) {
+    this.#sourceOrder = new Map(messages.map((message, index) => [message.id, index]));
+    this.#observations = observations;
+    const previous = publicationMembership(observations, prior);
+    this.#published = publicationMembership(observations, {
+      ...previous,
+      groups: previous.groups.flatMap((entry) => {
+        if (entry.status !== 'available') return [];
+        const valid = this.#available(entry.groupId, entry.messageIds, entry.basis);
+        return valid ? [valid] : [];
+      }),
+    });
+  }
+
+  #available(groupId: string, ids: readonly string[], basis: Available['basis']): Available | undefined {
+    if (!ids.length || ids.some((id) => !this.#sourceOrder.has(id))) return;
+    const messageIds = [...new Set(ids)].sort(
+      (left, right) => this.#sourceOrder.get(left)! - this.#sourceOrder.get(right)!,
+    );
+    return { groupId, status: 'available', basis, messageIds };
+  }
+
+  observe(observations: string, proof: ObservationProof | undefined) {
+    const previous = uniqueGroups(this.#observations);
+    const current = uniqueGroups(observations);
+    const inherited = this.#published.groups.filter(({ groupId }) => {
+      const group = current.get(groupId);
+      const prior = previous.get(groupId);
+      return group && prior && group.content === prior.content && group.range === prior.range &&
+        group.kind === prior.kind;
+    });
+    const member = proof && current.get(proof.groupId) && !previous.has(proof.groupId)
+      ? this.#available(proof.groupId, proof.messageIds, 'observe-input')
+      : undefined;
+    this.#observations = observations;
+    this.#published = publicationMembership(observations, {
+      ...this.#published,
+      groups: member ? [...inherited, member] : inherited,
+    });
+  }
+
+  reflect(source: string, observations: string, proof: ReflectionProof | undefined) {
+    const known = new Map(this.#published.groups.map((entry) => [entry.groupId, entry]));
+    const members: Available[] = [];
+    if (source === this.#observations) {
+      for (const { groupId, parentIds } of proof ?? []) {
+        const parents = parentIds.map((id) => known.get(id));
+        if (!parents.length || !parents.every((entry) => entry?.status === 'available')) continue;
+        const member = this.#available(groupId, parents.flatMap((entry) => entry.messageIds), 'retained-parents');
+        if (member) members.push(member);
+      }
+    }
+    this.#observations = observations;
+    this.#published = publicationMembership(observations, { ...this.#published, groups: members });
+  }
+
+  finish(observations: string) {
+    return observations === this.#observations
+      ? this.#published
+      : publicationMembership(observations);
+  }
+}
